{
  "name": "local-stack-proof",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "build": "npm run build -w @local-stack-proof/web && cargo build --workspace",
    "dev:api": "cargo run -p local-stack-proof-api",
    "dev:web": "npm run dev -w @local-stack-proof/web",
    "dev:desktop": "npm run dev -w @local-stack-proof/desktop",
    "build:desktop": "npm run build -w @local-stack-proof/desktop",
    "spike:desktop": "npm run spike:dev -w @local-stack-proof/desktop",
    "build:desktop:spike": "npm run spike:build -w @local-stack-proof/desktop",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "lint": "npm run lint -w @local-stack-proof/web && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "npm run test -w @local-stack-proof/web && cargo test --workspace",
    "test:postgres": "cargo test -p local-stack-proof-persistence-postgres -- --ignored",
    "test:e2e": "npm run test:e2e -w @local-stack-proof/web",
    "validate:local": "npm run validate && npm run test:postgres && npm run test:e2e",
    "contract:generate": "cargo run -p local-stack-proof-transport-http --bin api-contract -- --write",
    "contract:check": "cargo run -p local-stack-proof-transport-http --bin api-contract -- --check",
    "typecheck": "npm run typecheck -w @local-stack-proof/web",
    "validate": "npm run format:check && npm run contract:check && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
